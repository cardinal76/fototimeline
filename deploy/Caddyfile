# HTTPS con Let's Encrypt per il dominio di FotoTimeline. Caddy aggiunge da
# solo X-Forwarded-Proto e X-Forwarded-Host, che Spring usa per il login.
{$FOTOTIMELINE_DOMINIO} {
	encode zstd gzip
	request_body {
		# I video del telefono: fino a 8 GB per caricamento.
		max_size 8GB
	}
	reverse_proxy app:8080
}
