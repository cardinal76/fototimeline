# Da copiare in ~/fototimeline/.env su server2 (chmod 600). Non va nel repository.
# I valori con spazi vanno tra virgolette: il workflow di rilascio legge questo
# file anche con bash, che senza virgolette prenderebbe la parola dopo lo
# spazio per un comando.

# Cartella di lavoro su server2: dentro ci sono rclone/rclone.conf e cloud/ (punto di montaggio).
FOTOTIMELINE_DATI=/home/marco/fototimeline

# Dominio pubblico: record A verso l'IP di server2, porte 80 e 443 aperte.
FOTOTIMELINE_DOMINIO=foto.marcocardinali.it

# MongoDB, solo sulla rete interna di Docker.
MONGO_USER=fototimeline
MONGO_PASSWORD=cambiami

# Client "fototimeline" del realm "fototimeline" sul Keycloak di presenze (DEPLOY.md, passo 3).
KEYCLOAK_CLIENT_SECRET=cambiami
# KEYCLOAK_ISSUER=https://presenze.footballer.it/auth/realms/fototimeline

# Password dell'API di controllo di rclone (solo rete interna): una stringa lunga a caso.
RCLONE_RC_PASSWORD=cambiami
# Il remote di rclone.conf; i due punti finali servono.
RCLONE_REMOTO=lifetime:
# true = monta da solo dopo ogni rilascio o riavvio; false = aspetta un admin.
RCLONE_MONTA_ALL_AVVIO=false

# Backup dei metadati nel cloud (FotoTimeline/.backup): ogni quanto e quanti tenere.
FOTOTIMELINE_BACKUP_INTERVALLO=P1D
FOTOTIMELINE_BACKUP_TENERE=30

# Cartella di LifetimeCloud svuotata da sola nell'archivio (le foto si spostano),
# per esempio quella dove l'app di LifetimeCloud carica le foto del telefono.
# Il percorso è quello visto dall'app: la radice del cloud è /cloud.
# Vuota = spenta.
FOTOTIMELINE_CARTELLA_AUTOMATICA="/cloud/Da importare"
FOTOTIMELINE_INTERVALLO_AUTOMATICO=PT15M

# Il telefono di quando la sincronizzazione era una sola diventa "Telefono" nell'elenco
# dei telefoni: di chi è (username Keycloak). Vuoto = del primo amministratore che entra.
FOTOTIMELINE_TELEFONO_PROPRIETARIO=marco

# Avvisi su Telegram quando una voce della pagina "Salute" cambia stato (diventa
# rossa, torna a posto). Token del bot da BotFather e chat id (DEPLOY.md,
# "Avvisi su Telegram"). Vuoti = avvisi spenti; la pagina "Salute" c'è lo stesso.
FOTOTIMELINE_TELEGRAM_TOKEN=
FOTOTIMELINE_TELEGRAM_CHAT=
# true = avvisa anche quando una voce diventa gialla (per esempio il cloud smontato).
FOTOTIMELINE_TELEGRAM_ATTENZIONE=false

# "Accadde oggi" su Telegram ogni mattina (DEPLOY.md, "Ricordi su Telegram"): valori
# di partenza, poi si cambiano dall'app (Salute → Ricordi su Telegram).
FOTOTIMELINE_RICORDI_ATTIVO=true
FOTOTIMELINE_RICORDI_ORA=08:00
FOTOTIMELINE_RICORDI_FOTO=6
# Chat solo per i ricordi; vuota = quella degli avvisi (FOTOTIMELINE_TELEGRAM_CHAT).
FOTOTIMELINE_RICORDI_CHAT=
FOTOTIMELINE_RICORDI_NESSUNO=false
